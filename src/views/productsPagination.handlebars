<h1>Home e-commerce</h1>
<ul>
  {{#each products.docs}}
  <li>
    <h2>{{this.title}}</h2>
    <p>Preço: R$ {{this.price}}</p>
    <p>Categoria: {{this.category}}</p>
    <p>ID: {{this._id}}</p>
    <button onclick="addToCart('{{this._id}}')">Adicionar ao Carrinho</button>
    <a href="/products/mongo/{{this._id}}" target="_blank">
      <button>Detalhes</button>
    </a>
  </li>
  {{/each}}
</ul>
<div>
  {{#if products.hasPrevPage}}
    <a href="{{products.prevLink}}">Página Anterior</a>
  {{/if}}
  {{#if products.hasNextPage}}
    <a href="{{products.nextLink}}">Próxima Página</a>
  {{/if}}
</div>

<script>
  function addToCart(productId) {
    fetch(`/carts/mongo/addToCart/${productId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => alert(`${productId} adicionado ao carrinho com sucesso!`))
    .catch(error => alert(`Erro ao adicionar produto ${productId} ao carrinho`));
  }
</script>




