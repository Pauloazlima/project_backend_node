<form action="/auth/login" method="POST">
  <h2>Login</h2>
  <label>Email:</label>
  <input type="email" name="email" required />
  <label>Senha:</label>
  <input type="password" name="password" required />
  <button type="submit">Login</button>
</form>

<a href="/auth/github">
  <button>Login com GitHub</button>
</a>
